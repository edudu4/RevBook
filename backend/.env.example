# Copie para .env e preencha com valores reais — .env nunca é commitado (ver .gitignore).
# Usado pelo docker-compose.yml (Postgres local) e serve de referência para as
# mesmas variáveis que os 3 serviços Spring Boot esperam no ambiente.

# Chave HMAC compartilhada por auth-service, review-service e gateway para assinar/validar o JWT.
# Gere uma nova com: openssl rand -base64 48
JWT_SECRET=

# Credenciais do Postgres (usadas pelo docker-compose e pelos 3 application.yml).
DB_USERNAME=revbook
DB_PASSWORD=

# Client ID OAuth do Google (console.cloud.google.com) — usado pelo auth-service
# para validar o audience do ID token. Não é segredo (é público por design), mas
# fica configurável por ambiente.
GOOGLE_CLIENT_ID=

# Opcional — API key da Google Books API. Sem ela a busca funciona com cota bem menor.
GOOGLE_BOOKS=
